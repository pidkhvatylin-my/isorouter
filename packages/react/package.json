{
  "name": "@isorouter/react",
  "version": "1.2.1",
  "description": "React adapter for @isorouter/core.",
  "license": "MIT",
  "author": "Mykhailo Pidkhvatylin <michel.podkhvatilin@gmail.com>",
  "homepage": "https://github.com/pidkhvatylin-my/isorouter/tree/master/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidkhvatylin-my/isorouter.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/pidkhvatylin-my/isorouter/issues",
  "keywords": [
    "router",
    "routing",
    "spa",
    "navigation-api",
    "react",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && publint && eslint . && prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@isorouter/core": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@isorouter/test-utils": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "^1.2.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
